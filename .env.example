# ---------------------------------------------------------------------------
# Pick ONE protocol. The client is selected from LLM_PROTOCOL, or inferred
# from whichever API key is present.
#
#   LLM_PROTOCOL=anthropic  -> Anthropic Messages API
#   LLM_PROTOCOL=openai     -> OpenAI-compatible chat completions
# ---------------------------------------------------------------------------

LLM_PROTOCOL=anthropic

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OpenAI-compatible -----------------------------------------------------
# DeepSeek:  https://api.deepseek.com/v1        deepseek-chat
# GLM:       https://open.bigmodel.cn/api/paas/v4  glm-4.6
# Qwen:      https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus
# Ollama:    http://localhost:11434/v1          llama3.1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# MODEL_ID wins over the provider-specific model variable above.
MODEL_ID=
MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=180

# --- Chapter tuning --------------------------------------------------------
# COMPACT_TOOL_RESULT_BUDGET=200000
# COMPACT_SUMMARIZE_AT_TOKENS=24000
# COMPACT_KEEP_MESSAGES=8
# GOAL_MAX_TURNS=12
# SUBAGENT_MAX_TURNS=12
# TEAMMATE_MAX_TURNS=30
# PERMISSION_MODE=ask
# SKILLS_DIR=skills
# HOOKS_FILE=hooks.json
